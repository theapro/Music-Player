# Environment configuration for Music Player Backend
# Model configuration with correct types

# Default model types (corrected based on architecture)
DEFAULT_MISTRAL_TYPE=mistral
DEFAULT_NEMO_TYPE=llama

# Model paths
MISTRAL_MODEL_PATH=./models/Mistral-7B-Instruct-v0.1-Q4_K_M.gguf
NEMO_MODEL_PATH=./models/Mistral-Nemo-Instruct-2407-Q4_K_M.gguf

# Server configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# CORS configuration
ALLOW_ORIGINS=*
ALLOW_CREDENTIALS=true
ALLOW_METHODS=*
ALLOW_HEADERS=*

# Logging
LOG_LEVEL=INFO